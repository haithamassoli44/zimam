{
  "name": "zimam",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "nuxt-ui:templates": "bun -e \"await (await import('vite')).resolveConfig({}, 'serve')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "bun run nuxt-ui:templates && vue-tsc -p tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@iconify/vue": "5.0.4",
    "@nuxt/ui": "4.12.0",
    "@tanstack/vue-virtual": "3.13.48",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@iconify-json/octicon": "1.2.40",
    "@intlify/unplugin-vue-i18n": "11.2.7",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "wrangler": "4.158.0"
  },
  "packageManager": "bun@1.4.4"
}
