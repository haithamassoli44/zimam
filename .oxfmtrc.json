{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./src/style.css",
    "attributes": [":class", "v-bind:class"]
  },
  "ignorePatterns": ["dist/**", "src/locales/**"]
}
